{
  "name": "crypto-beats-server",
  "version": "1.0.0",
  "description": "Multiplayer server for Crypto Beats",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:ts": "ts-node index.ts",
    "start:prod": "node dist/index.js",
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "prestart": "npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "colyseus": "^0.15.0",
    "@colyseus/schema": "^2.0.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0"
  }
}

