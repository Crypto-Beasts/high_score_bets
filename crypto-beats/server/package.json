{
  "name": "crypto-beats-server",
  "version": "1.0.0",
  "description": "Multiplayer server for Crypto Beats",
  "author": "aguaoxigenada",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aguaoxigenada/high_score_bets.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:ts": "ts-node index.ts",
    "start:prod": "node dist/index.js",
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.0",
    "colyseus": "^0.15.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1"
  }
}
