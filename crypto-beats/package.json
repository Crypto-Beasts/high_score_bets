{
  "name": "crypto-beats",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "convert-midi": "python3 scripts/midi_to_json.py public/Aguado_Menuet_Aminor.mid public/music.json",
    "convert-midi:custom": "python3 scripts/midi_to_json.py",
    "validate-json": "python3 scripts/validate_json.py public/music.json",
    "midi:convert": "npm run convert-midi && npm run validate-json"
  },
  "keywords": [
    "rhythm-game",
    "phaser",
    "typescript",
    "colyseus",
    "multiplayer",
    "game"
  ],
  "author": "aguaoxigenada",
  "license": "MIT",
  "description": "A 4-lane rhythm game built with Phaser 3 and TypeScript, with real-time multiplayer via Colyseus.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aguaoxigenada/high_score_bets.git"
  },
  "dependencies": {
    "colyseus.js": "^0.15.0",
    "howler": "^2.2.4",
    "phaser": "^3.88.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1"
  }
}
